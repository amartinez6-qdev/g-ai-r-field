{
  "name": "g-ai-r-field",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted GitHub pull request reviewer with local RAG and OmniRoute",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "check:config": "tsx src/preflight.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.0.2",
    "@octokit/rest": "^22.0.0",
    "fastify": "^5.6.1",
    "openai": "^6.7.0",
    "pino": "^10.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
