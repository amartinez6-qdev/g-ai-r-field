NODE_ENV=development
PORT=8787
CONFIG_PATH=reviewer.config.yml
DATABASE_PATH=data/g-air-field.sqlite

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_API_URL=https://api.github.com
# Optional GitHub App mode. Leave GITHUB_TOKEN set for PAT mode.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=

# Use http://omniroute:20128/v1 inside Docker Compose, or
# http://127.0.0.1:20128/v1 when the reviewer runs directly on the host.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
